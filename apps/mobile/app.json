{
  "expo": {
    "name": "LDR Companion",
    "slug": "ldr-companion",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "ldr",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6F8",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFF6F8",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.ldrcompanion.app",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocalNetworkUsageDescription": "LDR Companion connects to the Ember & Tide game server running on your Mac during local development.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.ldrcompanion.app"
    },
    "plugins": ["expo-status-bar", "expo-secure-store", "expo-notifications"],
    "extra": {
      "supabaseUrl": "https://xbtnbrzwnarbqrqsxdch.supabase.co",
      "supabaseAnonKey": "sb_publishable_zn63Az1gIyofJTV8D4NozA_41AsHoAx"
    }
  }
}
