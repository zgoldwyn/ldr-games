# The local server needs no Colyseus account or cloud credentials.
PORT=2567

# Explicitly enables the local-only POST /dev/platformer-sessions endpoint.
# Never enable this route in a deployed environment.
GAME_SERVER_ENABLE_DEV_ADMISSION=true

# A local shared secret required in the x-dev-admission-key request header.
# Choose any non-empty development-only value; do not commit your real value.
GAME_SERVER_DEV_ADMISSION_KEY=replace-with-a-local-secret
