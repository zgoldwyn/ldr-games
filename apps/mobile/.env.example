# Existing Supabase configuration (use `supabase status` for a local stack).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# LOCAL DEVELOPMENT ONLY. Never put this shared dev key in TestFlight or a
# production build. Both iOS simulators must use the same values.
EXPO_PUBLIC_GAME_SERVER_URL=http://127.0.0.1:2567
EXPO_PUBLIC_GAME_SERVER_DEV_ADMISSION_KEY=replace-with-the-same-local-server-key
