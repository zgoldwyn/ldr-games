{
  "name": "@ldr/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native / Expo mobile shell for the LDR Companion App",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:simulator": "expo start --ios",
    "bundle:check": "expo export --platform ios --output-dir .expo/bundle-check"
  },
  "dependencies": {
    "@ldr/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@supabase/supabase-js": "^2.115.0",
    "@types/react": "~19.2.4",
    "expo": "^57.0.19",
    "expo-constants": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  }
}
