{
  "name": "ldr-companion-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform companion app for people in long-distance relationships",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:integration:local": "./scripts/with-supabase-env.sh npx vitest run --project integration --no-file-parallelism",
    "edge:check": "npm run build && deno check --config supabase/functions/deno.json supabase/functions/*/index.ts supabase/functions/_shared/*.ts",
    "edge:test": "npm run build && deno test --config supabase/functions/deno.json supabase/functions/_shared/",
    "edge:lint": "deno lint --config supabase/functions/deno.json supabase/functions",
    "edge:fmt:check": "deno fmt --check --config supabase/functions/deno.json supabase/functions",
    "verify": "npm run build && npm run lint && npm run test && npm run edge:check && npm run edge:test",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:functions": "supabase functions serve",
    "game-server:dev": "npm run dev --workspace @ldr/game-server",
    "game-server:start": "npm run start --workspace @ldr/game-server",
    "game-server:test": "npm run test --workspace @ldr/game-server",
    "ios:two": "node scripts/ios-two-simulators.mjs",
    "word-chain:lexicon": "node scripts/generate-word-chain-lexicon.mjs",
    "level-builder": "npm run build --workspace @ldr/core && node apps/level-builder/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "deno": "2.1.4",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supabase": "^2.115.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "word-list": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "deno@2.1.4": true
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
